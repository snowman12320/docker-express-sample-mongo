<!DOCTYPE html>
<html>
  <head>
    <title id="page-title"></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 text-gray-900">
    <!-- 導覽列開始 -->
    <nav class="bg-white shadow mb-8">
      <div class="max-w-4xl mx-auto px-4">
        <div class="flex justify-between items-center h-16">
          <div class="flex-shrink-0 flex items-center">
            <span class="text-xl font-bold text-blue-600">Express+MongoDB</span>
          </div>
          <div class="flex space-x-4">
            <a
              href="/"
              class="text-gray-700 hover:text-blue-500 px-3 py-2 rounded-md text-md font-medium transition-all duration-300 transform hover:scale-110 hover:rotate-3 hover:bg-blue-100"
              >首頁</a
            >
            <a
              href="/gemini"
              class="text-gray-700 hover:text-blue-500 px-3 py-2 rounded-md text-md font-medium transition-all duration-300 transform hover:scale-110 hover:rotate-3 hover:bg-blue-100"
              >Gemini</a
            >
            <a
              href="/about"
              class="text-gray-700 hover:text-blue-500 px-3 py-2 rounded-md text-md font-medium transition-all duration-300 transform hover:scale-110 hover:rotate-3 hover:bg-blue-100"
              >關於</a
            >
            <a
              href="/contact"
              class="text-gray-700 hover:text-blue-500 px-3 py-2 rounded-md text-md font-medium transition-all duration-300 transform hover:scale-110 hover:rotate-3 hover:bg-blue-100"
              >聯絡我們</a
            >
          </div>
        </div>
      </div>
    </nav>
    <!-- 導覽列結束 -->
    <div
      class="max-w-md mx-auto mt-16 bg-white rounded-xl shadow-lg p-8 text-center"
    >
      <h1
        id="header"
        class="text-3xl font-bold mb-2 text-blue-500 tracking-wider"
      >
        歡迎
      </h1>
      <p
        id="welcome"
        class="text-base text-gray-600 mb-8"
      >
        這是 Express + MongoDB 範例首頁
      </p>
      <a
        id="link"
        href="#"
        class="inline-block px-7 py-2 bg-gradient-to-r from-blue-500 to-cyan-400 text-white rounded-md font-semibold text-lg shadow hover:from-blue-700 hover:to-cyan-600 transition"
        >gemini</a
      >
    </div>
    <script>
      // 从 URL 参数获取 baseURL
      const baseURL = new URLSearchParams(window.location.search);
      const title = '首頁';

      // 设置标题
      document.getElementById('page-title').textContent = title;

      // 设置链接
      const link = document.getElementById('link');
      link.href = baseURL + '/gemini';
      link.textContent = 'gemini';
    </script>

    <% if (process.env.ENV === 'dev') { %>
    <script type="module">
      import { initToolbar } from 'https://cdn.jsdelivr.net/npm/@stagewise/toolbar/+esm';
      const stagewiseConfig = { plugins: [] };
      initToolbar(stagewiseConfig);
    </script>
    <% } %>
  </body>
</html>
